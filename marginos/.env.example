# Required for live AI investigations and PDF/image invoice extraction.
# Without it MarginOS runs the investigator in a clearly labelled deterministic demo mode.
ANTHROPIC_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-opus-5-5
# Where the embedded Postgres (PGlite) database and uploaded files are stored.
# Defaults to ~/.marginos (outside the project folder).
# MARGINOS_DATA_DIR=
