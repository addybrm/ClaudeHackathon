# Copy to backend/.env. Never commit .env. Never put these values in frontend code.

# --- AI advisor ---------------------------------------------------------------
# Leave blank to run the deterministic, clearly labelled DEMO advisor.
# A Claude Pro/Max subscription is NOT an API key; create one at console.anthropic.com.
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default) or claude-sonnet-5-5 (about half the cost)
ANTHROPIC_MODEL=claude-opus-5-5

# --- Security -----------------------------------------------------------------
# false = demo mode: requests without a token act as the demo owner. Use true for anything real.
AUTH_REQUIRED=false
# Set a long random value so tokens survive restarts (python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=
TOKEN_TTL_HOURS=12

# --- Storage / CORS -----------------------------------------------------------
# DATABASE_URL=sqlite:///./margin_os.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
